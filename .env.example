# ============================================
# IOT DASHBOARD - ENVIRONMENT CONFIGURATIE
# ============================================
# Kopieer dit bestand naar .env en vul eigen waarden in:
#
#   cp .env.example .env
#
# Het .env bestand staat in .gitignore en hoort NOOIT in Git.
# ============================================


# --------------------------------------------
# VERPLICHT - de API start niet zonder deze twee
# --------------------------------------------

# Wachtwoord voor de MariaDB applicatiegebruiker.
# Genereer er een met:  openssl rand -base64 32
MARIADB_PASSWORD=

# Sleutel waarmee sessiecookies worden ondertekend.
# Minimaal 32 tekens. Genereer er een met:  openssl rand -base64 48
#
# Let op: verander je deze waarde, dan worden alle bestaande sessies
# ongeldig en moet iedereen opnieuw inloggen.
JWT_SECRET=


# --------------------------------------------
# OPTIONEEL - defaults zijn prima om te beginnen
# --------------------------------------------

# Database naam en gebruiker
MARIADB_DATABASE=iot_dashboard
MARIADB_USER=iot_user

# Poort waarop het dashboard bereikbaar is op de VM
WEB_PORT=3002

# Zet op true zodra je HTTPS hebt (met een certificaat).
# Op false blijft het sessiecookie ook over plain HTTP werken.
COOKIE_SECURE=false

# Sensor simulatie.
# Zet SIMULATOR_ENABLED=false zodra echte sensoren via
# POST /api/sensors aanleveren, anders lopen simulatie en
# echte metingen door elkaar heen.
SIMULATOR_ENABLED=true

# Hoe vaak er een nieuwe meting bijkomt (milliseconden)
SENSOR_INTERVAL_MS=60000

# Maximaal aantal metingen dat bewaard blijft.
# De limiet wordt door de API toegepast na elke insert
# (server/src/db.js -> enforceSensorLimit).
SENSOR_LOG_LIMIT=500
