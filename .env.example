# ============================================
# SUPABASE ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIES:
# 1. Kopieer dit bestand naar .env
# 2. Vul je Supabase credentials in (zie hieronder)
# 3. Restart development server
#
# HOE TE VINDEN:
# Ga naar je Supabase project dashboard
# > Settings > API
# ============================================

# Project URL (bijvoorbeeld: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Anon/Public Key (lang token dat begint met eyJhbGc...)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️ BELANGRIJK:
# - Gebruik ALLEEN de "anon public" key, NOOIT de "service_role" key!
# - De "anon" key is veilig om in frontend code te gebruiken
# - Alle variabelen moeten beginnen met VITE_ voor Vite projecten
# - Restart je dev server na het wijzigen van .env

# ============================================
# OPTIONEEL: Voor productie
# ============================================

# Service Role Key (ALLEEN server-side gebruiken!)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Direct Connection (voor migraties)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
